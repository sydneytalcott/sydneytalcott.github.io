      "content": {
        "title": "Sydney Talcott",
        "metaDescription": "Sydney Talcott is a product leader for 3D, spatial computing and real estate tech, trained as an architect. Product work at Magic Leap, Zillow and CBRE.",
        "heroEyebrow": "Open to product leadership roles",
        "heroHeadline": "Product leader for 3D, spatial computing and real estate tech. Trained as an architect.",
        "heroSubtitle": "I build the tools and platforms people use to design, visualize and work in three dimensions, most recently at Magic Leap, Zillow and CBRE.",
        "ctaText": "View work",
        "ctaLink": "/work",
        "cta2Text": "Get in touch",
        "cta2Link": "#contact",
        "aboutTitle": "About",
        "aboutImage": "/media/profile.jpg",
        "aboutImageAlt": "Sydney Talcott Portrait",
        "aboutLead": "I trained as an architect, and I still approach products the way I approached buildings: by making complex systems intuitive for the people who use them.",
        "aboutText": "Since 2013 I have built 3D and spatial products for real estate and XR: interactive 3D visualization and digital twins for commercial real estate at Floored and CBRE, 3D home capture across millions of listings at Zillow, and spatial OS applications at Magic Leap. Most recently I have been on assignment at Google, leading product definition for Android XR.",
        "focusLabel": "Product",
        "focus1": "Product strategy and roadmapping",
        "focus2": "Discovery and user research",
        "focus3": "Go-to-market",
        "focus4": "Cross-functional leadership",
        "skillsLabel": "Domain",
        "skill1": "Spatial experience design",
        "skill2": "3D content creation and pipelines",
        "skill3": "Creative tooling",
        "skill4": "Generative AI in product",
        "lookingLabel": "Looking for",
        "lookingText": "Product leadership roles in spatial computing, 3D tooling and real estate tech. Remote or hybrid, United States.",
        "experienceTitle": "Experience",
        "exp1Years": "2022 – 2026",
        "exp1Role": "Principal Product Manager, Strategic Consulting",
        "exp1Company": "Magic Leap · on assignment at Google",
        "exp1Point1": "Lead product definition and cross-company execution for Android XR identity, biometric authentication and custom device fitting, and direct strategy for core Android XR system applications and spatial AI agent features.",
        "exp1Point2": "Owned strategy and roadmaps for Magic Leap’s user-facing OS applications, platform services and app distribution, and developed a patent-pending predictive ML model to optimize 3D environment generation and reduce spatial tracking latency.",
        "exp1Point3": "Shipped Magic Leap’s first on-device 3D viewing app and an NVIDIA Omniverse USD viewer for enterprise developers.",
        "exp2Years": "2021 – 2022",
        "exp2Role": "Senior Product Manager",
        "exp2Company": "Zillow",
        "exp2Point1": "Defined product strategy and roadmap for creator tools and partner workflows across Zillow’s platform.",
        "exp2Point2": "Evolved Zillow’s immersive 3D digital twin capture application, scaling spatial mapping across millions of interactive listings.",
        "exp2Point3": "",
        "exp3Years": "2017 – 2021",
        "exp3Role": "Senior Director, Product Management & Visualization",
        "exp3Company": "CBRE",
        "exp3Point1": "Oversaw global product strategy, budgeting and execution across advisory, transaction and marketing technology portfolios, leading distributed product, design and vendor teams.",
        "exp3Point2": "Built and scaled a global visualization studio for enterprise real estate marketing and sales pitches, and owned internal 3D tooling strategy.",
        "exp3Point3": "Led the post-acquisition integration of Floored’s 3D platform into CBRE and defined the operating strategy for enterprise digital twin initiatives.",
        "caseStudyLinkText": "Case study →",
        "earlierYears": "2011 – 2017",
        "earlierRole": "3D art direction and architecture",
        "earlierText": "Floored: Senior 3D Artist to Director of 3D Art & Production (2013–2017) · SHoP Architects: Visualization Specialist (2013) · Columbia University GSAPP: design studio teaching assistant and Urban Landscape Lab research assistant (2011–2013)"
      }
    },
